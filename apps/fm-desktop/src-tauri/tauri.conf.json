{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.fm.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5181",
    "frontendDist": "../../../frontend/dist",
    "beforeDevCommand": "pnpm exec cross-env VITE_RUNTIME=tauri pnpm --dir ../../frontend exec vite --port 5181",
    "beforeBuildCommand": "pnpm exec cross-env VITE_RUNTIME=tauri pnpm --dir ../../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "Procyon",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"]
  }
}
