{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Manager",
  "version": "0.1.0",
  "identifier": "dev.fm.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../frontend/dist",
    "beforeDevCommand": "pnpm --dir ../../../frontend dev",
    "beforeBuildCommand": "pnpm --dir ../../../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "File Manager",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
