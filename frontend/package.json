{
  "name": "@fm/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mithril frontend for the dual-pane file manager, shared by the Axum and Tauri hosts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:directory-table": "vitest run src/features/directory-table/directory-table.benchmark.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "3.4.13",
    "meiosis-setup": "^6.2.3",
    "mithril": "^2.3.8",
    "mithril-materialized": "^3.17.9",
    "slimdown-js": "1.4.1"
  },
  "devDependencies": {
    "@mithril-inspector/vite": "0.3.2",
    "@types/mithril": "^2.2.8",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "orval": "^8.24.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
