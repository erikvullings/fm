{
  "name": "@fm/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mithril frontend for the dual-pane file manager, shared by the Axum and Tauri hosts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "mergerino": "^0.4.0",
    "mithril": "^2.3.8",
    "mithril-materialized": "^3.17.7"
  },
  "devDependencies": {
    "@types/mithril": "^2.2.8",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "orval": "^8.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
