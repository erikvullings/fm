#!/usr/bin/env sh

staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
if [ -n "$staged_rs" ]; then
  echo "$staged_rs" | xargs rustfmt --edition 2024
  echo "$staged_rs" | xargs git add
fi

staged_rust=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' '**/Cargo.toml' 'Cargo.toml' 'Cargo.lock')
if [ -n "$staged_rust" ]; then
  manifests=''
  for path in $staged_rust; do
    directory=$(dirname "$path")
    while [ "$directory" != '.' ] && [ ! -f "$directory/Cargo.toml" ]; do
      directory=$(dirname "$directory")
    done
    manifest="$directory/Cargo.toml"
    case "
$manifests
" in
      *"
$manifest
"*) ;;
      *) manifests="${manifests}${manifest}
" ;;
    esac
  done

  for manifest in $manifests; do
    if [ "$manifest" = './Cargo.toml' ]; then
      cargo clippy --workspace --all-targets -- -D warnings
      cargo test --workspace
    else
      cargo clippy --manifest-path "$manifest" --all-targets -- -D warnings
      cargo test --manifest-path "$manifest"
    fi
  done
fi

staged_biome=$(git diff --cached --name-only --diff-filter=ACM \
  -- 'frontend/**/*.ts' 'frontend/**/*.tsx' 'frontend/**/*.css' 'frontend/**/*.json' \
     'scripts/**/*.mjs' '*.json' \
  | { grep -v '^frontend/src/api/generated/' || true; })
if [ -n "$staged_biome" ]; then
  echo "$staged_biome" | xargs pnpm exec biome check --write --no-errors-on-unmatched
  echo "$staged_biome" | xargs git add
fi

exit 0
